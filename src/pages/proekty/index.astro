---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.js';
import { cases } from '../../data/cases.js';

const path = '/proekty/';
const title = 'Реализованные проекты — комплектация из Китая | Relent';
const description =
  'Примеры проектов, реализованных под ключ: квартиры, частные дома, отели, рестораны и коммерческие объекты. Состав поставки и бюджет по каждому проекту.';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Проекты', item: SITE.url + path },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: cases.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: `${c.tag} — ${c.title}`,
      url: `${SITE.url}/proekty/${c.slug}/`,
    })),
  },
];
---

<Base title={title} description={description} canonical={path} jsonld={jsonld}>
  <main class="subpage">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span class="sep">/</span><span class="cur">Проекты</span>
      </nav>
      <div class="page-head">
        <h1>Реализованные проекты</h1>
        <p class="page-lede">
          Примеры проектов реализованных под ключ из Китая — от отдельных зон до полной комплектации
          объекта. По каждому показываем состав поставки и бюджет.
        </p>
      </div>

      <div class="card-grid">
        {cases.map((c) => (
          <a class="pcard" href={`/proekty/${c.slug}/`}>
            <div class="pcard-photo" style={`background-image:url('${c.photo}')`}></div>
            <div class="pcard-body">
              <div class="pcard-tag">{c.tag}</div>
              <div class="pcard-name">{c.title}</div>
              <p style="color:var(--grey); font-size:13.5px; line-height:1.5; margin:2px 0;">{c.short}</p>
              <div class="pcard-price">Общий чек · <b>{c.budget}</b></div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="cta-band">
      <div class="wrap">
        <div>
          <h2>Посчитаем ваш проект</h2>
          <p>Пришлите дизайн-проект или спецификацию — бесплатно подберём 10 позиций и покажем выгоду.</p>
        </div>
        <a class="btn light" href="/kontakty/">Отправить проект <span class="btn-arrow">→</span></a>
      </div>
    </div>
  </main>
</Base>
