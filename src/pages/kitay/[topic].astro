---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.js';
import { chinaTopics } from '../../data/china.js';
import { orgRef, pageId, imageId, abs } from '../../data/schema.js';

export function getStaticPaths() {
  return chinaTopics.map((t) => ({ params: { topic: t.slug }, props: { t } }));
}

const { t } = Astro.props;
const path = `/kitay/${t.slug}/`;
const title = `${t.title} — Relent`;
const description = t.lede;

const idx = chinaTopics.findIndex((x) => x.slug === t.slug);
const next = chinaTopics[(idx + 1) % chinaTopics.length];

const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Китай', item: abs('/kitay/') },
      { '@type': 'ListItem', position: 3, name: t.title, item: abs(path) },
    ],
  },
  {
    // Article — связан с компанией как автором и издателем
    '@type': 'Article',
    '@id': `${abs(path)}#article`,
    headline: t.h1,
    description: t.lede,
    image: { '@id': imageId(path) },
    author: orgRef,
    publisher: orgRef,
    mainEntityOfPage: { '@id': pageId(path) },
    inLanguage: 'ru-RU',
    dateModified: t.updated,
    about: orgRef,
    articleSection: 'Производство в Китае',
  },
];
---

<Base title={title} description={description} canonical={path} ogImage={t.image} jsonld={jsonld}>
  <main class="subpage">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span class="sep">/</span>
        <a href="/kitay/">Китай</a><span class="sep">/</span>
        <span class="cur">{t.title}</span>
      </nav>

      <div class="page-head">
        <h1>{t.h1}</h1>
        <p class="page-lede">{t.lede}</p>
      </div>

      <div
        style={`aspect-ratio:16/6; background-image:url('${t.image}'); background-size:cover; background-position:center; border:1px solid var(--line); margin-bottom:40px;`}
        role="img"
        aria-label={t.title}
      ></div>

      <div class="prose">
        <p>{t.intro}</p>

        {t.sections.map((s) => (
          <>
            <h2>{s.h2}</h2>
            {s.p && s.p.map((par) => <p>{par}</p>)}
            {s.checks && (
              <ul class="checks">
                {s.checks.map((c) => <li>{c}</li>)}
              </ul>
            )}
            {s.cards && (
              <div class="factbar" style="margin:18px 0 8px;">
                {s.cards.map((c) => (
                  <div>
                    <div class="fv" style="font-size:19px;">{c.name}</div>
                    <div style="color:var(--grey); font-size:13.5px; line-height:1.5; margin-top:8px;">{c.what}</div>
                  </div>
                ))}
              </div>
            )}
          </>
        ))}
      </div>

      <div style="padding-top:56px;">
        <h2 style="font-family:var(--ff-display); font-weight:500; font-size:26px; margin-bottom:6px;">
          Читать дальше
        </h2>
        <div class="card-grid">
          <a class="pcard" href={`/kitay/${next.slug}/`}>
            <div class="pcard-photo" style={`background-image:url('${next.image}')`}></div>
            <div class="pcard-body">
              <div class="pcard-name">{next.title}</div>
              <p style="color:var(--grey); font-size:13.5px; line-height:1.5; margin:2px 0;">{next.lede}</p>
            </div>
          </a>
          <a class="pcard" href="/dostavka-nds/">
            <div class="pcard-photo" style="background-image:url('/images/hero.jpg')"></div>
            <div class="pcard-body">
              <div class="pcard-name">Доставка и НДС</div>
              <p style="color:var(--grey); font-size:13.5px; line-height:1.5; margin:2px 0;">
                Белая логистика, таможенное оформление и доставка на объект по России.
              </p>
            </div>
          </a>
          <a class="pcard" href="/proekty/">
            <div class="pcard-photo" style="background-image:url('/images/case-full.jpg')"></div>
            <div class="pcard-body">
              <div class="pcard-name">Реализованные проекты</div>
              <p style="color:var(--grey); font-size:13.5px; line-height:1.5; margin:2px 0;">
                Объекты, укомплектованные под ключ через прямую закупку в Китае.
              </p>
            </div>
          </a>
        </div>
      </div>
    </div>

    <div class="cta-band">
      <div class="wrap">
        <div>
          <h2>Нужен расчёт по вашему проекту?</h2>
          <p>Пришлите спецификацию — подберём фабрики, проверим качество и посчитаем стоимость.</p>
        </div>
        <a class="btn light" href="/kontakty/">Получить расчёт <span class="btn-arrow">→</span></a>
      </div>
    </div>
  </main>
</Base>
