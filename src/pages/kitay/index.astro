---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.js';
import { chinaTopics } from '../../data/china.js';
import { orgRef, pageId, abs } from '../../data/schema.js';

const path = '/kitay/';
const title = 'Производство в Китае: фабрики, качество, закупка — Relent';
const description =
  'Как устроено производство мебели и материалов в Китае: чем фабрика отличается от посредника, кто что производит в Гуанчжоу, Фошане и Шэньчжэне, как проверяется качество и как идёт закупка.';

const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Китай', item: abs(path) },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'Разделы о производстве в Китае',
    itemListElement: chinaTopics.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.title,
      url: abs(`/kitay/${t.slug}/`),
    })),
  },
];
---

<Base title={title} description={description} canonical={path} ogImage="/images/why-factory.jpg" jsonld={jsonld}>
  <main class="subpage">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span class="sep">/</span><span class="cur">Китай</span>
      </nav>
      <div class="page-head">
        <h1>Производство в Китае</h1>
        <p class="page-lede">
          Мы находимся в Гуандуне и работаем с фабриками напрямую. Здесь собрано то, что обычно
          остаётся за кадром: как устроен рынок производителей, кто что делает в разных городах,
          как проверяется качество и что происходит с заказом внутри Китая.
        </p>
      </div>

      <div class="factbar">
        <div><div class="fv">150+</div><div class="fl">Фабрик-партнёров</div></div>
        <div><div class="fv">3</div><div class="fl">Города производства</div></div>
        <div><div class="fv">4</div><div class="fl">Точки контроля качества</div></div>
        <div><div class="fv">0</div><div class="fl">Посредников в цепочке</div></div>
      </div>

      <div class="card-grid">
        {chinaTopics.map((t) => (
          <a class="pcard" href={`/kitay/${t.slug}/`}>
            <div class="pcard-photo" style={`background-image:url('${t.image}')`}></div>
            <div class="pcard-body">
              <div class="pcard-name">{t.title}</div>
              <p style="color:var(--grey); font-size:13.5px; line-height:1.5; margin:2px 0;">{t.lede}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="prose" style="padding-top:56px;">
        <h2>Что дальше</h2>
        <p>
          Как проект проходит путь от чертежа до объекта — на странице
          {' '}<a href="/kak-rabotaem/">«Как проходит работа»</a>. Про международную перевозку,
          таможню и вычет НДС — в разделе <a href="/dostavka-nds/">«Доставка и НДС»</a>.
          Готовые примеры — в <a href="/proekty/">проектах</a>.
        </p>
      </div>
    </div>

    <div class="cta-band">
      <div class="wrap">
        <div>
          <h2>Обсудить проект с теми, кто в Китае</h2>
          <p>Пришлите спецификацию или дизайн-проект — подберём фабрики и посчитаем стоимость.</p>
        </div>
        <a class="btn light" href="/kontakty/">Получить расчёт <span class="btn-arrow">→</span></a>
      </div>
    </div>
  </main>
</Base>
